# Server-side Google Maps API Key (Optional)
# Get your API key from: https://console.cloud.google.com/google/maps-apis
# This is optional - the site works perfectly without it using static maps
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Copy this file to .env.local and add your actual API key if you want interactive maps
# The website works perfectly without this - it will show a beautiful static map instead
